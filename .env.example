# Server-only credentials. Supply through the deployment platform's secret store.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_TIMEOUT_SECONDS=45
NEBIUS_MAX_RETRIES=1
# Production: set to an absolute path on a mounted writable persistent volume.
# AFL_DATABASE_PATH=/var/data/agent_forensics.db
# Optional sidecar override; otherwise stored alongside AFL_DATABASE_PATH.
# AFL_BUDGET_DATABASE_PATH=/var/data/afl_public_budget.sqlite3
# Same-origin requires no CORS origins. Never use a wildcard.
AFL_CORS_ORIGINS=
# Server listens on PORT through python -m backend.app.api.serve.
PORT=8000
AFL_MAX_CONCURRENT_REQUESTS=32
AFL_MAX_CONCURRENT_WORKFLOWS=1
AFL_RATE_LIMIT_REQUESTS=6
AFL_RATE_LIMIT_WINDOW_SECONDS=60
AFL_MAX_REQUEST_BYTES=32768
AFL_MAX_MODEL_CALLS_PER_WORKFLOW=128
# Conservatively reserves SDK initial + possible retry slots before each API model call.
AFL_DAILY_MODEL_REQUEST_LIMIT=500
# Optional public-API output cap; unset preserves the provider's existing default.
# AFL_MODEL_MAX_OUTPUT_TOKENS=4096
# Only set known trusted reverse-proxy addresses/CIDRs. No wildcard.
# AFL_TRUSTED_PROXY_IPS=127.0.0.1
